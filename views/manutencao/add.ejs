<%-include('../cabecalho.ejs')%>
    <h1>Adicionar Cliente</h1>
    <div>
        <a href="/manutencao/lst">Listar</a>
    </div>
    <div>
        <form method="post">
            <label>Oficina:</label>
            <input type="text" name="oficina"><br>
            <label>Valor:</label>
            <input type="number" name="valor"><br>
            <label>Data:</label>
            <input type="datetime-local" name="data"><br>
            <div class="mb-3">
                <label for="veiculo" class="form-label">Veiculo</label>
                <select name="veiculo" id="veiculo" class="form-control">
                <option value="">selecione</option>
                <%Veiculos.forEach(function(veiculo){%>
                <option value='<%=veiculo.id%>'>
                <%=veiculo.nome%>
                </option>
                <%})%>
                </select>
            </div>
            <button type="submit">Cadastrar</button>

        </form>
    </div>

    <%-include('../rodape.ejs')%>