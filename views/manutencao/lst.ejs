<%-include('../cabecalho.ejs')%>
    <h1>Manutencaos</h1>
    <div>
        <form action="
        " method="post">
            <input type="text" name="filtro" id="" placeholder="digite o nome">
            <button type="submit">Pesquisar</button>
        </form>
    </div>
    <a href="/manutencao/add">+ Manutencao</a>
    <table>
        <tr>
            <td>Oficina</td>
            <td>Valor</td>
            <td>Data</td>
            <td>Veículo</td>
            <td>Ações</td>
        </tr>

        <%for (const {id, oficina, valor, data, veiculo} of Manutencaos) {%>
            <tr>
                <td>
                    <%=oficina%>
                </td>
                <td>
                    <%=valor%>
                </td>
                <td>
                    <%=data%>
                </td>
                <td>
                    <%=veiculo%>
                </td>
                <td><a href="/manutencao/edt/<%=id%>">Editar</a>
                    <a href="/manutencao/del/<%=id%>">Excluir</a>
                </td>
            </tr>
            <%}%>
    </table>
    <%-include('../rodape.ejs')%>