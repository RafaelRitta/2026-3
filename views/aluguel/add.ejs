<%-include('../cabecalho.ejs')%>
    <h1>Alugar</h1>
    <div>
        <a href="/aluguel/lst">Listar</a>
    </div>
    <div>
        <form method="post">
            <div class="mb-3">
                <label for="cliente" class="form-label">Cliente</label>
                <select name="cliente" id="cliente" class="form-control">
                <option value="">selecione</option>
                <%Cliente.forEach(function(cliente){%>
                <option value='<%=cliente.nome%>'>
                <%=cliente.id%>
                </option>
                <%})%>
                </select>
            </div>
            <label>Valor:</label>
            <input type="number" name="valor"><br>
            <label>Data:</label>
            <input type="datetime-local" name="data"><br>
            <div class="mb-3">
                <label for="veiculo" class="form-label">Veiculo</label>
                <select name="veiculo" id="veiculo" class="form-control">
                <option value="">selecione</option>
                <%Veiculo.forEach(function(veiculo){%>
                <option value='<%=veiculo.modelo%>'>
                <%=veiculo.id%>
                </option>
                <%})%>
                </select>
            </div>
            <button type="submit">Cadastrar</button>

        </form>
    </div>

    <%-include('../rodape.ejs')%>