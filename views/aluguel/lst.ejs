<%-include('../cabecalho.ejs')%>
    <h1>Aluguels</h1>
    <div>
        <form action="" method="post">
            <input type="text" name="filtro" id="" placeholder="digite o nome">
            <button type="submit">Pesquisar</button>
        </form>
    </div>
    <a href="/aluguel/add">+ Aluguel</a>
    <table>
        <tr>
            <td>Cliente</td>
            <td>Valor</td>
            <td>Data</td>
            <td>Veículo</td>
            <td>Ações</td>
        </tr>

        <%for (const {id, cliente, valor, data, veiculo} of Aluguels) {%>
            <tr>
                <td>
                    <%= cliente ? cliente.nome : 'Cliente removido' %>
                </td>
                <td>
                    R$ <%= Number(valor).toFixed(2).replace('.', ',') %>
                </td>
                <td>
                    <%= new Date(data).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) %>
                </td>
                <td>
                    <%= veiculo ? `${veiculo.marca} ${veiculo.modelo}` : 'Veículo removido' %>
                </td>
                <td>
                    <a href="/aluguel/edt/<%=id%>">Editar</a>
                    <a href="/aluguel/del/<%=id%>">Excluir</a>
                </td>
            </tr>
        <%}%>
    </table>
<%-include('../rodape.ejs')%>